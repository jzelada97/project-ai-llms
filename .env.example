# Copia este archivo a .env y rellena tus valores. NUNCA subas .env al repo.

# Proveedor de LLM: "groq" (por defecto, gratis con límites) u "ollama" (local)
LLM_PROVIDER=groq

# Clave gratuita en https://console.groq.com/keys (solo si LLM_PROVIDER=groq)
GROQ_API_KEY=

# Opcional: sobreescribe el modelo por defecto
#   groq   -> openai/gpt-oss-120b  (más rápido y ligero: openai/gpt-oss-20b)
#   ollama -> llama3.2
MODEL_NAME=

# Solo para Ollama
OLLAMA_BASE_URL=http://localhost:11434
